# --- Gemini (generare scenarii) ---
GEMINI_API_KEY=

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- YouTube (OAuth2) ---
# Metoda recomandata (functioneaza headless, fara fisiere):
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Fallback bazat pe fisiere (doar pentru rulare locala interactiva):
YOUTUBE_CLIENT_SECRET_FILE=config/client_secret.json
YOUTUBE_TOKEN_FILE=config/token.json

# Optional: API key simplu (nu OAuth) pentru YouTube Data API, folosit pentru
# a vedea ce videoclipuri sunt populare acum pe YouTube in Romania si a alege
# subiecte cu sanse mai mari de vizualizari. Se creeaza gratuit din Google
# Cloud Console -> APIs & Services -> Credentials -> Create API Key
# (activeaza "YouTube Data API v3" pe proiect). Daca lipseste, sistemul
# foloseste doar Google Trends.
YOUTUBE_API_KEY=

# --- Supabase (storage stare pipeline) ---
# URL-ul proiectului (fara /rest/v1), si "secret key" (server-side, bypass RLS)
SUPABASE_URL=
SUPABASE_KEY=

# --- Generale ---
TIMEZONE=Europe/Bucharest
